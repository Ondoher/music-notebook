{
	"name": "mn",
	"dest": "dist/mn",
	"source": "src/mn",
	"index": "src/mn/index.js",
	"spec": "src/mn/test.js",
	"testDest": "tests/",
	"router": "server/mn/index.js",
	"template": {
		"source": "src/mn/templates/index.html",
		"destination": "dist/mn/index.html"
	},
	"resources": [
		{
			"dest": "images",
			"cwd": "assets/images",
			"glob": "**/*.{png,jpg,gif,svg}",
			"keepNest": true
		},
		{
			"dest": "icons",
			"cwd": "assets/pwa",
			"glob": "**/*.{ico,jpg,svg,gif,png}",
			"keepNest": true
		},
		{
			"dest": "fonts",
			"cwd": "assets/fonts",
			"glob": "**/*.{woff,woff2}",
			"keepNest": true
		}
	],
	"css": [
		{
			"dest": "styles",
			"cwd": "assets/styles",
			"glob": "**/*.css",
			"keepNest": true
		}
	],
	"features": ["features/app", "features/player", "features/editor"]
}
